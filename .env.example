# Bot token from @BotFather
TOKEN=YOUR_BOT_TOKEN

# Chat id of the channel receiving reminders
CHANNEL_CHAT_ID=-1001234567890

# Chat id receiving error reports
DEBUG_CHAT_ID=12345678

# --- Optional overrides (defaults shown) ---
# REMINDER_OFFSETS=24h,1h,5m
# CALENDAR_REFRESH_TIME=02:00
# DATABASE_PATH=fantaformazionibot.db
# DEADLINE_MARGIN=5m
# If non-empty, commands are answered only in these chats (dev bot whitelist)
# ALLOWED_CHAT_IDS=12345678,-1001234567890
# Inline queries carry no chat, so the line above cannot gate them (ADR 0033).
# If non-empty, inline mode answers only these users (dev bot whitelist)
# ALLOWED_USER_IDS=12345678

# CALENDAR_PROVIDER=fixturedownload
# CALENDAR_URL=https://fixturedownload.com/download/serie-a-{season_year}-UTC.csv
# Alternative source (ADR 0014): CALENDAR_PROVIDER=football-data-org
# requires a free API key from football-data.org (see docs.football-data.org)
# FOOTBALL_DATA_API_KEY=

# Dev-only testing aid (ADR 0016): fabricates a matchday kicking off soon, so
# a real reminder can be triggered on demand. NEVER set on production.
# CALENDAR_PROVIDER=mock
# MOCK_KICKOFF_OFFSET=10m
